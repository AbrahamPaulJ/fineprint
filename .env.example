OTARI_API_KEY=otk_your_key
# Optional: EU accounts use https://eu.api.otari.ai/api/v1
# OTARI_BASE=https://api.otari.ai/api/v1
# Per-user budgets: a service key plus the budget new end users start on
# FINEPRINT_USER=abraham
# FINEPRINT_END_USER_BUDGET=<budget id>
# Routing policies by role (fallbacks and budget tier-down)
# FINEPRINT_MODEL_READER=fp-reader
# FINEPRINT_MODEL_CALCULATOR=fp-calculator
# FINEPRINT_MODEL_INVESTIGATOR=fp-investigator
# FINEPRINT_MODEL_JUDGE=fp-judge
# MCP lead server, public https URL
# Stored server id from Tools > MCP servers (or FINEPRINT_MCP_URL if the workspace allows servers by URL)
# FINEPRINT_MCP_SERVER_ID=<id>
# FINEPRINT_MCP_URL=https://<tunnel>/mcp
# FINEPRINT_MCP_TOKEN=<secret>
# Our guardrail service (hosted Otari has none), same server as MCP
# FINEPRINT_GUARD_URL=https://<tunnel>
